# =====================================================
# ✏️ WAJIB DIGANTI
# GANTI X DENGAN NOMOR ABSEN MASING-MASING
# =====================================================
# Contoh: Jika nomor absen Anda adalah 17:
# 192.168.X.10 -> 192.168.17.10 (HAProxy Load Balancer)
# 192.168.X.11 -> 192.168.17.11 (Web Server 01)
# 192.168.X.12 -> 192.168.17.12 (Web Server 02)
# 192.168.X.13 -> 192.168.17.13 (Database Server MariaDB)
# =====================================================

# Database Configuration (MariaDB / MySQL)
DB_CONNECTION=mysql
DB_HOST=192.168.X.13
DB_PORT=3306
DB_NAME=kopdes
DB_USER=kopdes_user
DB_PASS=CHANGE_ME

# Application Settings
APP_NAME=KopDes
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.X.10

# Load Balancer & High Availability Awareness
# Node identifier (misal WEB-01 pada server pertama, WEB-02 pada server kedua)
SERVER_NODE=WEB-01
HAPROXY_IP=192.168.X.10
HAPROXY_STATUS=ONLINE
