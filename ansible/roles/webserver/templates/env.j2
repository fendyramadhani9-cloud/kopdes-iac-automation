# ==============================================================================
# KopDes Environment Configuration
# Di-generate secara otomatis oleh Ansible untuk node {{ server_node_name }}
# ==============================================================================

APP_NAME="{{ app_name }}"
APP_ENV={{ app_env }}
APP_DEBUG={{ app_debug | lower }}
APP_URL=http://{{ haproxy_ip }}

# Cluster & Load Balancer Awareness
SERVER_NODE={{ server_node_name }}
HAPROXY_IP={{ haproxy_ip }}
HAPROXY_STATUS=ONLINE

# MariaDB Connection (Node DB01: {{ db_host }})
DB_CONNECTION=mysql
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASS={{ db_password }}

# Session & Security
SESSION_LIFETIME=7200
